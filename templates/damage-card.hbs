<div class="dice-roll damage-card">
  <div class="roll-line">
    <span class="roll-label">{{label}}</span>
    <span class="roll-total" data-tooltip="{{system.formula}}">{{system.total}}</span>
    {{#if system.isCriticalDamage}}
      <span class="roll-icon critical-damage" data-tooltip="{{localize 'DANGEROUSGARY.Roll.CriticalDamage'}}"><i class="fas fa-burst"></i></span>
    {{/if}}
    {{#if system.isConstrained}}
      <span class="roll-icon constrained" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Constrained'}}"><i class="fas fa-link"></i></span>
    {{/if}}
    {{#if system.isExalted}}
      <span class="roll-icon exalted" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Exalted'}}"><i class="fas fa-crown"></i></span>
    {{/if}}
    {{#if system.ignoreArmour}}
      <span class="roll-icon ignore-armour" data-tooltip="{{localize 'DANGEROUSGARY.Roll.IgnoreArmour'}}"><i class="fas fa-shield-slash"></i></span>
    {{/if}}
  </div>

  <ul class="damage-targets">
    {{#each targets as |target|}}
      <li class="damage-target {{#if target.isDead}}dead{{/if}}">
        <a class="target-token" data-action="panToToken" data-token-uuid="{{target.tokenUuid}}" data-tooltip="{{localize 'DANGEROUSGARY.Damage.PanToToken'}}">
          <img src="{{target.img}}" alt="{{target.name}}" />
        </a>
        <div class="target-body">
          <span class="target-name">{{target.name}}</span>
          {{#if target.showDetail}}
            <span class="target-line">
              {{#if target.halved}}{{localize "DANGEROUSGARY.Damage.Halved"}} · {{/if}}{{#if target.armour}}
                {{localize "DANGEROUSGARY.Damage.ArmourDetail" armour=target.armour real=target.real}}
              {{else}}
                {{localize "DANGEROUSGARY.Damage.RealDetail" real=target.real}}
              {{/if}}
            </span>
            {{#if target.applied}}
              {{!-- Perte et état : seulement si des dégâts sont réellement subis après l'armure --}}
              {{#if target.real}}
                <span class="target-line target-loss {{#if target.strLost}}overflow{{/if}}">
                  <i class="fas fa-heart-crack"></i>
                  {{#if target.strLost}}
                    {{localize "DANGEROUSGARY.Roll.TalentDamageWithStr" hp=target.hpLost str=target.strLost}}
                  {{else}}
                    {{localize "DANGEROUSGARY.Roll.TalentDamage" hp=target.hpLost}}
                  {{/if}}
                </span>
                <span class="target-line target-state">
                  {{localize "DANGEROUSGARY.Damage.StateHp" before=target.hpBefore after=target.hpAfter}}{{#if target.strLost}} · {{localize "DANGEROUSGARY.Damage.StateStr" before=target.strBefore after=target.strAfter}}{{/if}}
                </span>
              {{/if}}
              {{#if target.isDead}}
                <span class="target-line target-dead"><i class="fas fa-skull"></i> {{localize "DANGEROUSGARY.Damage.StrengthZero"}}</span>
              {{/if}}
              {{#if target.canRollStrSave}}
                <button type="button" class="damage-card-button" data-action="rollStrSave" data-index="{{@index}}">
                  <i class="fas fa-dice-d20"></i> {{localize "DANGEROUSGARY.Damage.StrSave"}}
                </button>
              {{else if target.shockResult}}
                <span class="target-line {{#if target.saveSuccess}}target-save-done{{else}}target-dead{{/if}}">{{target.shockResult}}</span>
              {{else if target.saveRolled}}
                <span class="target-line target-save-done"><i class="fas fa-check"></i> {{localize "DANGEROUSGARY.Damage.StrSaveDone"}}</span>
              {{/if}}
              {{#each target.triggers as |trigger|}}
                <span class="target-line target-trigger {{trigger.status}}">
                  <i class="fas fa-bolt"></i> <strong>{{trigger.name}}</strong>{{#if trigger.summary}} : {{trigger.summary}}{{/if}}
                </span>
                {{#if trigger.canRollSave}}
                  <button type="button" class="damage-card-button" data-action="rollTriggerSave" data-index="{{@../index}}" data-trigger-index="{{@index}}">
                    <i class="fas fa-dice-d20"></i> {{trigger.saveLabel}}
                  </button>
                {{/if}}
              {{/each}}
            {{else}}
              <span class="target-line target-pending">{{localize "DANGEROUSGARY.Damage.NotApplied"}}</span>
            {{/if}}
          {{else}}
            <span class="target-line">{{localize "DANGEROUSGARY.Damage.Dealt" total=@root.system.total}}</span>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ul>

  {{#if canApply}}
    <button type="button" class="damage-card-button" data-action="applyDamage">
      <i class="fas fa-heart-crack"></i> {{localize "DANGEROUSGARY.Damage.Apply"}}
    </button>
  {{/if}}
</div>
