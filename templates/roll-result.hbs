<div class="dice-roll">
  {{#if talentName}}
    <div class="roll-talent-name">{{talentName}}</div>
  {{/if}}
  <div class="roll-line">
    <span class="roll-label" {{#if (eq rollType "save")}}data-tooltip="{{#if isOsmoseSave}}{{localize 'DANGEROUSGARY.Osmose.Tooltip'}}{{else if isClassSave}}{{localize 'DANGEROUSGARY.Roll.ClassSave'}}{{else}}{{localize 'DANGEROUSGARY.Roll.AbilitySave'}}{{/if}}"{{/if}}>{{{introText}}}</span>
    <span class="roll-total" {{#if formula}}data-tooltip="{{formula}}"{{/if}}>{{total}}</span>
    {{#if (eq rollType "save")}}
      {{#if success}}
        {{#if isCritical}}
          <span class="roll-icon success critical" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Critical'}}"><i class="fas fa-check-double"></i></span>
        {{else}}
          <span class="roll-icon success" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Success'}}"><i class="fas fa-check"></i></span>
        {{/if}}
      {{else}}
        {{#if isFumble}}
          <span class="roll-icon failure fumble" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Fumble'}}"><i class="fas fa-skull-crossbones"></i></span>
        {{else}}
          <span class="roll-icon failure" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Failure'}}"><i class="fas fa-times"></i></span>
        {{/if}}
      {{/if}}
    {{/if}}
    {{#if isUnlucky}}
      <span class="roll-icon unlucky" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Unlucky'}}"><i class="fas fa-cat"></i></span>
    {{/if}}
    {{#if isCriticalDamage}}
      <span class="roll-icon critical-damage" data-tooltip="{{localize 'DANGEROUSGARY.Roll.CriticalDamage'}}"><i class="fas fa-burst"></i></span>
    {{/if}}
    {{#if isConstrained}}
      <span class="roll-icon constrained" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Constrained'}}"><i class="fas fa-link"></i></span>
    {{/if}}
    {{#if isExalted}}
      <span class="roll-icon exalted" data-tooltip="{{localize 'DANGEROUSGARY.Roll.Exalted'}}"><i class="fas fa-crown"></i></span>
    {{/if}}
  </div>
  {{#if osmoseRequired}}
    <div class="roll-osmose">
      <i class="fas fa-dungeon"></i> {{localize "DANGEROUSGARY.Osmose.Required"}}
      <button type="button" class="osmose-roll-button" data-action="rollOsmose" data-actor-uuid="{{actorUuid}}">
        <i class="fas fa-dice-d20"></i> {{localize "DANGEROUSGARY.Osmose.RollButton"}}
      </button>
    </div>
  {{/if}}
  {{#if osmoseGauge}}
    <div class="roll-osmose"><i class="fas fa-eye"></i> {{osmoseGauge}}</div>
  {{/if}}
  {{#if osmoseAsset}}
    <div class="roll-osmose">{{osmoseAsset}}</div>
  {{/if}}
  {{#if osmoseDisappeared}}
    <div class="roll-osmose disappeared"><i class="fas fa-ghost"></i> {{localize "DANGEROUSGARY.Osmose.Disappeared"}}</div>
  {{/if}}
  {{#if ignoreArmour}}
    <div class="roll-trigger"><i class="fas fa-shield-slash"></i> {{localize "DANGEROUSGARY.Roll.IgnoreArmour"}}</div>
  {{/if}}
  {{#each triggers as |trigger|}}
    <div class="roll-trigger"><i class="fas fa-bolt"></i> <strong>{{trigger.name}}</strong>{{#if trigger.summary}} : {{trigger.summary}}{{/if}}</div>
  {{/each}}
  {{#if talentDamage}}
    <div class="roll-talent-damage">
      <i class="fas fa-heart-crack"></i>
      {{#if talentStrLost}}
        {{localize "DANGEROUSGARY.Roll.TalentDamageWithStr" hp=talentHpLost str=talentStrLost}}
      {{else}}
        {{localize "DANGEROUSGARY.Roll.TalentDamage" hp=talentHpLost}}
      {{/if}}
    </div>
  {{/if}}
</div>
