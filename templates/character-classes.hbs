<section class="tab standard-form character-classes {{tab.cssClass}}" data-group="primary" data-tab="classes" {{#unless enableClasses}}hidden{{/unless}}>
{{#if enableClasses}}
  <div class="osmose-block">
    <span class="osmose-label rollable" data-action="rollOsmose" data-tooltip="{{localize 'DANGEROUSGARY.Osmose.RollTooltip'}}">{{localize "DANGEROUSGARY.Labels.long.osmose"}}</span>
    <div class="osmose-pips {{#if locked}}disabled{{/if}}">
      <span class="osmose-pip {{#if (gte system.osmose 1)}}filled{{/if}}" {{#unless locked}}data-action="toggleOsmose"{{/unless}} data-value="1"></span>
      <span class="osmose-pip {{#if (gte system.osmose 2)}}filled{{/if}}" {{#unless locked}}data-action="toggleOsmose"{{/unless}} data-value="2"></span>
      <span class="osmose-pip {{#if (gte system.osmose 3)}}filled{{/if}}" {{#unless locked}}data-action="toggleOsmose"{{/unless}} data-value="3"></span>
    </div>
    {{!-- État de situation : modifiable dans les deux modes --}}
    <label class="osmose-dungeon" data-tooltip="{{localize 'DANGEROUSGARY.Osmose.DungeonHint'}}">
      <i class="fas fa-dungeon"></i> {{localize "DANGEROUSGARY.Osmose.InDungeon"}}
      <input type="checkbox" name="system.inDungeon" {{checked system.inDungeon}} />
    </label>
  </div>
  {{!-- Mode Lecture : seulement les classes où le personnage a des niveaux ; mode édition : toutes --}}
  {{#if (and locked (not hasClassLevels))}}
  <p class="classes-empty">{{localize "DANGEROUSGARY.Talent.NoClasses"}}</p>
  {{else}}
  <div class="classes-panel panel">
    <div class="classes-grid">
      {{#if (or (not @root.locked) system.classes.cleric)}}
      <div class="class-cell">
        <div class="class-header">
          <span class="class-name">{{localize "DANGEROUSGARY.Talent.Classes.cleric"}} ({{localize "DANGEROUSGARY.Labels.short.str"}})</span>
          <span class="class-level">{{system.classes.cleric}}</span>
        </div>
        <span class="class-talents-label">{{localize "DANGEROUSGARY.Labels.long.talents"}}</span>
        <div class="class-talents">
          {{#each talentsByClass.cleric as |talent|}}
            <div class="talent draggable" draggable="true" data-item-id="{{talent.id}}" data-drag-type="rollClassSave" data-talent-class="{{talent.system.talentClass}}">
              <span class="talent-name" data-tooltip-html="{{talent.enrichedDescription}}" data-tooltip-direction="UP">{{talent.name}}{{#if talent.system.special}}*{{/if}} ({{talent.system.level}})</span>
              <div class="talent-controls">
                {{#if @root.locked}}
                <span class="rollable" data-action="rollClassSave" data-talent-class="{{talent.system.talentClass}}" data-item-id="{{talent.id}}" data-tooltip="{{localize 'DANGEROUSGARY.RollClassSave'}}" data-tooltip-direction="UP"><i class="fas fa-dice-d20"></i></span>
                {{else}}
                <a data-action="edit" data-item-id="{{talent.id}}" data-tooltip="{{localize 'DANGEROUSGARY.Talent.Edit'}}"><i class="fas fa-edit"></i></a>
                <a data-action="delete" data-item-id="{{talent.id}}" data-tooltip-html="{{localize 'DANGEROUSGARY.Talent.Delete'}}{{#if @root.isGM}}<br>{{localize 'DANGEROUSGARY.DeleteShiftHint'}}{{/if}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
